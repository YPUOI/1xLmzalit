rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (isSignedIn() && request.auth.token.email == 'ilyassedalame3@gmail.com') ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Teams Collection
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Matches Collection
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Predictions Collection
    match /predictions/{predictionId} {
      allow read: if true;
      allow create, update: if isValidId(predictionId) &&
        request.resource.data.matchId is string &&
        request.resource.data.username is string &&
        request.resource.data.homeScore is number &&
        request.resource.data.awayScore is number &&
        request.resource.data.homeScorers is list &&
        request.resource.data.awayScorers is list;
      allow delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) &&
        request.resource.data.username is string &&
        (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 100)) &&
        request.resource.data.role in ['user', 'admin'] &&
        request.resource.data.points is number &&
        request.resource.data.status in ['pending', 'approved'];
      allow delete: if isAdmin();
    }

    // Application Settings (including global friend password)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
